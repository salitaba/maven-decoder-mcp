# Maven Decoder MCP Server Configuration
# Copy this file to .env or set these environment variables

# Maven repository location. First set value wins:
# 1. MAVEN_REPOSITORY (or MAVEN_REPO): direct path to the repository
# 2. MAVEN_HOME (or M2_HOME): Maven install dir or repository dir
# 3. <localRepository> in ~/.m2/settings.xml
# 4. Fallback: ~/.m2/repository
# MAVEN_REPOSITORY=F:\data\repository
# MAVEN_HOME=~/.m2/repository

# ---------------------------------------------------------------------------
# Online Maven support (enabled by default)
# ---------------------------------------------------------------------------

# Disable ALL network access and behave exactly like a local-only server
# MAVEN_OFFLINE=true

# Keep online search but never auto-download missing artifacts
# MAVEN_AUTO_DOWNLOAD=false

# Remote repositories used for downloads (comma or space separated).
# Default: https://repo1.maven.org/maven2
# MAVEN_REMOTE_REPOS=https://nexus.corp/repository/maven-public

# Solr search endpoints (comma or space separated).
# Default: https://search.maven.org/solrsearch/select
# MAVEN_SEARCH_URL=https://search.maven.org/solrsearch/select

# Where downloaded artifacts are cached (standard Maven layout).
# Default: ~/.cache/maven-decoder-mcp/repository
# MAVEN_DECODER_CACHE_DIR=~/.cache/maven-decoder-mcp/repository

# Credentials for a private mirror
# MAVEN_REMOTE_USERNAME=builder
# MAVEN_REMOTE_PASSWORD=secret

# Per-request timeout in seconds (default: 30)
# MAVEN_HTTP_TIMEOUT=30

# Retries for transient network failures / throttling (default: 3)
# MAVEN_HTTP_RETRIES=3

# Maximum download size in bytes (default: 104857600 = 100MB)
# MAVEN_MAX_DOWNLOAD_SIZE=104857600

# Verify downloads against the published SHA-1 checksum (default: true)
# MAVEN_VERIFY_CHECKSUM=true

# ---------------------------------------------------------------------------
# Server behaviour
# ---------------------------------------------------------------------------

# Logging level (DEBUG, INFO, WARNING, ERROR)
MCP_LOG_LEVEL=INFO

# Response Management Configuration
# Maximum response size in bytes before pagination (default: 50000)
MCP_MAX_RESPONSE_SIZE=50000

# Default items per page for pagination (default: 20)
MCP_MAX_ITEMS_PER_PAGE=20

# Maximum text length before summarization (default: 10000)
MCP_MAX_TEXT_LENGTH=10000

# Maximum lines before summarization (default: 500)
MCP_MAX_LINES=500

# Example configurations for different use cases:

# For large repositories (more aggressive pagination)
# MCP_MAX_RESPONSE_SIZE=30000
# MCP_MAX_ITEMS_PER_PAGE=10
# MCP_MAX_TEXT_LENGTH=5000
# MCP_MAX_LINES=200

# For detailed analysis (less aggressive pagination)
# MCP_MAX_RESPONSE_SIZE=100000
# MCP_MAX_ITEMS_PER_PAGE=50
# MCP_MAX_TEXT_LENGTH=20000
# MCP_MAX_LINES=1000
