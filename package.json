{
  "name": "maven-decoder-mcp",
  "version": "1.3.0",
  "description": "MCP server for reading and decompiling Maven jar files, with online Maven Central search and comprehensive Java project analysis",
  "main": "index.js",
  "bin": {
    "maven-decoder-mcp": "./bin/maven-decoder-mcp.js"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "start": "node bin/maven-decoder-mcp.js"
  },
  "keywords": [
    "mcp",
    "maven",
    "java",
    "decompiler",
    "jar",
    "analysis",
    "cursor",
    "ide",
    "model-context-protocol",
    "maven-central",
    "search"
  ],
  "author": "Your Name",
  "license": "MIT",
  "homepage": "https://github.com/salitaba/maven-decoder-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/salitaba/maven-decoder-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/salitaba/maven-decoder-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {},
  "files": [
    "bin/",
    "scripts/",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "os": [
    "darwin",
    "linux", 
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
